// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "show_edit_predictions": false,
  "proxy": "",
  "markdown_preview": {
    "open_markdown_files_in_preview": false
  },
  "cursor_animation": {
    "enabled": true
  },
  "diff_view_style": "split",
  "code_lens": "on",
  "languages": {
    "Python": {
      "colorize_brackets": true,
      "inlay_hints": {
        "show_background": false
      },
      "indent_guides": {
        "background_coloring": "indent_aware",
        "coloring": "indent_aware"
      }
    }
  },
  "diagnostics": {
    "lsp_pull_diagnostics": {
      "enabled": false
    },
    "include_warnings": false,
    "inline": {
      "enabled": false
    }
  },
  "diagnostics_max_severity": "error",
  "ssh_connections": [
    {
      "host": "infs3200-e8fb8a49.zones.eait.uq.edu.au",
      "username": "s4985050",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/s4985050/Assignment-2"
          ]
        }
      ]
    }
  ],
  "cli_default_open_behavior": "existing_window",
  "disable_ai": false,
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "button": false,
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "agent_servers": {
    "opencode": {
      "default_config_options": {
        "mode": "build",
        "effort": "high",
        "model": "opencode/x-preview-f-free"
      },
      "type": "registry"
    },
    "gemini": {
      "type": "registry"
    },
    "codex-acp": {
      "default_config_options": {
        "fast-mode": false,
        "mode": "agent-full-access",
        "reasoning_effort": "high",
        "model": "gpt-6.1-sol"
      },
      "type": "registry"
    },
    "amp-acp": {
      "type": "registry"
    },
    "github-copilot-cli": {
      "type": "registry"
    },
    "cursor": {
      "default_config_options": {
        "effort": "high",
        "reasoning": "max",
        "fast": "false",
        "model": "grok-4.6",
        "mode": "agent"
      },
      "favorite_config_option_values": {
        "mode": [
          "ask"
        ]
      },
      "type": "registry"
    }
  },
  "agent": {
    "show_turn_stats": true,
    "thinking_display": "always_collapsed",
    "threads_sidebar": {
      "position": "left"
    },
    "dock": "right",
    "default_profile": "ask",
    "default_model": {
      "provider": "copilot_chat",
      "model": "claude-haiku-4.5",
      "enable_thinking": false
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "calls": {
    "mute_on_join": true
  },
  "icon_theme": {
    "mode": "light",
    "light": "Zed (Default)",
    "dark": "VSCode Icons for Zed (Dark)"
  },
  "redact_private_values": true,
  "autosave": {
    "after_delay": {
      "milliseconds": 900
    }
  },
  "ui_font_family": ".ZedSans",
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font Mono"
  },
  "edit_predictions": {
    "allow_data_collection": "no",
    "provider": "none"
  },
  "project_panel": {
    "dock": "right"
  },
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "GitHub Light Tritanopia",
    "dark": "GitHub Dark Colorblind"
  }
}
